Attribute VB_Name = "donar_registration_DataReport1"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport1_Initialize()

  dater1.Caption = Format(Date, "dd-mm-yyyy")

    With DataReport1
        .PaperSize = vbPRPSA4
        .Orientation = rptOrientPortrait

        .LeftMargin = 0
        .RightMargin = 0
        .TopMargin = 200
        .BottomMargin = 200

        .ReportWidth = 12200   ' SAFE width for A4 Portrait
    End With

End Sub


Private Sub DataReport1_Activate()

    Me.Sections("Section1").Controls("txtReportDate").Text = _
        Format(Date, "dd-mm-yyyy")

End Sub



